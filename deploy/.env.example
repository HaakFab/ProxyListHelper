# Copy this to deploy/.env on the server (or locally for a docker-compose
# dry run) and fill in real values. Never commit deploy/.env -- .gitignore
# already excludes it.
#
# On your Mac, the real values already live in ~/.mtg-portal/env after
# following deploy/ACCOUNT-SETUP.md -- copy them across, don't retype them:
#   scp ~/.mtg-portal/env root@<server-ip>:/opt/portal/deploy/.env

SECRET_KEY=
WORKER_TOKEN=
ADMIN_PASSWORD=
INVITE_CODE=
PAYPAL_ME_HANDLE=
PORTAL_DOMAIN=proxies.yourdomain.de

# Absolute path is set by docker-compose.yml itself (DATABASE_URL=sqlite:////data/portal.db)
# -- no need to set it here.

MAIL_BACKEND=none
RETENTION_DAYS=90

# The PUBLIC half of your age backup key (see ~/.mtg-portal/backup-key.txt on
# your Mac -- run `grep 'public key' ~/.mtg-portal/backup-key.txt`). Backups
# are encrypted to this key; only the PRIVATE half (which never leaves your
# Mac) can decrypt them.
BACKUP_AGE_PUBLIC_KEY=age1...
